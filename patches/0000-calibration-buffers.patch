diff --git a/driver/src/tobiifree_core.zig b/driver/src/tobiifree_core.zig
index d3c2d3b..5394a2c 100644
--- a/driver/src/tobiifree_core.zig
+++ b/driver/src/tobiifree_core.zig
@@ -1048,7 +1048,9 @@ var next_req_id: u32 = 1;
 
 // Dedicated out buffer so request_* returns only a length; JS copies it
 // via take_session_out (or reads directly at session_out_ptr).
-var session_out: [512]u8 = undefined;
+// Sized to hold the largest calibration frame: a 4096-byte blob (out_scratch.len)
+// plus 34 bytes of envelope, TTP header and 2-byte payload prefix.
+var session_out: [8192]u8 = undefined;
 var session_out_len: usize = 0;
 
 fn pendingInsert(seq: u32, req_id: u32) void {
@@ -2496,3 +2498,58 @@ test "parse fragmented multi-envelope response" {
     try std.testing.expectEqual(@as(usize, 0), test_error_count);
     try std.testing.expectEqual(@as(usize, 0), acc_len);
 }
+
+test "session_out can hold a maximum calibration blob" {
+    const MAX_BLOB: usize = 4096;
+    const TTP_OVERHEAD: usize = 34; // envelope + header + 2-byte prefix
+    try std.testing.expect(session_out.len >= MAX_BLOB + TTP_OVERHEAD);
+}
+
+// Couples the two buffers so growing out_scratch without growing session_out fails,
+// and derives the 34-byte overhead rather than trusting the literal above.
+test "session_out fits a frame built from a full scratch buffer" {
+    const TTP_OVERHEAD: usize = ENVELOPE_SIZE + TTP_HDR_SIZE + 2;
+    try std.testing.expectEqual(@as(usize, 34), TTP_OVERHEAD);
+    try std.testing.expect(session_out.len >= scratch_size() + TTP_OVERHEAD);
+}
+
+var test_resp_len: u32 = 0;
+var test_resp_count: usize = 0;
+fn testHook_response(request_id: u32, payload_ptr: [*]const u8, payload_len: u32) void {
+    _ = request_id;
+    _ = payload_ptr;
+    test_resp_len = payload_len;
+    test_resp_count += 1;
+}
+
+// plen is device controlled and bounded only by ACC_CAP, so a response payload can
+// reach on_response far larger than the daemon's fixed onResponse stack buffer. That
+// buffer must therefore be guarded, not sized on trust. Feeding an oversized frame
+// here proves the precondition rather than assuming it.
+test "on_response delivers a payload larger than the daemon response buffer" {
+    const DAEMON_RESP_BUF: u32 = 8192; // main.zig onResponse MAX_RESPONSE_PAYLOAD
+    const PLEN: usize = 100000;
+    const saved_hook = hook_response;
+    defer hook_response = saved_hook;
+
+    resetTestState();
+    session_reset();
+    set_hooks(null, null, testHook_response, null, null);
+    test_resp_len = 0;
+    test_resp_count = 0;
+
+    const frame = try std.testing.allocator.alloc(u8, ENVELOPE_SIZE + TTP_HDR_SIZE + PLEN);
+    defer std.testing.allocator.free(frame);
+    const payload = try std.testing.allocator.alloc(u8, PLEN);
+    defer std.testing.allocator.free(payload);
+    @memset(payload, 0x5a);
+
+    pendingInsert(77, 9);
+    const n = fakeInbound(frame.ptr, TTP_MAGIC_RSP, 77, 0x200, payload);
+    feed_usb_in(frame.ptr, n);
+
+    try std.testing.expectEqual(@as(usize, 1), test_resp_count);
+    try std.testing.expectEqual(@as(u32, PLEN), test_resp_len);
+    try std.testing.expect(test_resp_len > DAEMON_RESP_BUF);
+    try std.testing.expectEqual(@as(usize, 0), test_error_count);
+}
