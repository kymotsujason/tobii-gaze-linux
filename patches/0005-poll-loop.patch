+// ---------- Main-loop poll set ----------
+
+const POLL_TIMEOUT_MS = 50; // cap, so a SIGTERM is noticed on an idle daemon
+
+// notify pipe, both listen sockets, and every client slot of both servers.
+const MAX_POLL_FDS = 3 + @typeInfo(@FieldType(Server, "clients")).array.len +
+    @typeInfo(@FieldType(WsServer, "clients")).array.len;
+var poll_fds: [MAX_POLL_FDS]std.posix.pollfd = undefined;
+
+/// Block until there is something to service. The loop this replaces slept 1ms
+/// unconditionally, so the notify pipe was dead weight, every sample gained up
+/// to 1ms, and the process woke 1000 times a second.
+///
+/// Established client fds are in the set, not just the listeners: with only the
+/// listeners a connected client's command waits out POLL_TIMEOUT_MS, which is
+/// worse than the sleep this replaces.
+fn pollWait() void {
+    var n: usize = 0;
+    poll_fds[n] = .{ .fd = notify_pipe[0], .events = std.posix.POLL.IN, .revents = 0 };
+    n += 1;
+    poll_fds[n] = .{ .fd = server.listen_fd, .events = std.posix.POLL.IN, .revents = 0 };
+    n += 1;
+
+    // The USB thread removes clients through sendToClient, so reading an fd out
+    // of the array needs the lock. It is held for the copy and nothing else.
+    server.lock.lock();
+    for (&server.clients) |*slot| {
+        const client = &(slot.* orelse continue);
+        var events: i16 = std.posix.POLL.IN;
+        // Output parked on WouldBlock is retried by flushPending. Without
+        // POLLOUT that retry waits for the timeout instead of for the socket.
+        if (client.out_off < client.out_len) events |= std.posix.POLL.OUT;
+        poll_fds[n] = .{ .fd = client.fd, .events = events, .revents = 0 };
+        n += 1;
+    }
+    server.lock.unlock();
+
+    if (ws) |*w| {
+        poll_fds[n] = .{ .fd = w.listen_fd, .events = std.posix.POLL.IN, .revents = 0 };
+        n += 1;
+        // WsServer has no lock and the USB thread already walks this array in
+        // sendToClient. A torn read here yields a closed fd, so poll reports
+        // POLLNVAL and the next iteration sees the slot gone.
+        for (&w.clients) |*slot| {
+            const client = &(slot.* orelse continue);
+            poll_fds[n] = .{ .fd = client.fd, .events = std.posix.POLL.IN, .revents = 0 };
+            n += 1;
+        }
+    }
+
+    _ = std.posix.poll(poll_fds[0..n], POLL_TIMEOUT_MS) catch 0;
+}
