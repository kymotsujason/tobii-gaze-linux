+/// Tear the dead USB session down and rebuild it. Runs on the USB thread, which
+/// owns the transport and the tracker outright while it is in here: the main
+/// thread refuses commands on device_present, and usbPause cannot succeed
+/// because usb_polls stops advancing, so it returns false and the command is
+/// refused rather than run against a half-open endpoint.
+fn reconnect() void {
+    device_present.store(false, .release);
+    broadcastStatus(); // Task 9
+    failPending();
+
+    tracker.deinit();
+    transport.deinit();
+
+    var backoff_ms: u64 = 100;
+    while (!quit) {
+        log.err("USB fatal, reinitialising in {d}ms", .{backoff_ms});
+        sleepUntilQuit(backoff_ms);
+        if (quit) return;
+        backoff_ms = @min(backoff_ms * 2, 2000);
+
+        transport = LibusbTransport.init() catch continue;
+        tracker = Tracker.init(.{
+            .send_fn = &transportSend,
+            .recv_fn = &transportRecv,
+            .try_recv_fn = &transportTryRecv,
+        }) catch {
+            // Leaving the handle open would make the next open_device fail with
+            // ClaimInterface against this process's own claim.
+            transport.deinit();
+            continue;
+        };
+
+        // Tracker.init leaves queryDisplayArea's capture hook installed and
+        // handshake_init reset the core session, so both hooks have to be put
+        // back. Without them a replug streams no gaze and drops every routed
+        // response, while reporting success.
+        tracker.onGaze(onGaze);
+        core.set_hooks(null, null, onResponse, null, null);
+
+        // ExecStartPost does not re-run for an in-process reconnect, so the
+        // geometry is replayed here. Same rule as boot: only write what the
+        // device does not already hold, since calibration is computed in that
+        // frame and a replug that preserved it must not be overwritten from a
+        // config that may be stale.
+        if (force_display_area or tracker.display.isReset()) {
+            log.info("replaying display area after reconnect", .{});
+            if (!tracker.setDisplayArea(display_area)) log.err("display area replay failed", .{});
+        } else {
+            log.info("device display area preserved across reconnect", .{});
+        }
+        applySavedCalibration(); // Task 9
+
+        device_present.store(true, .release);
+        broadcastStatus(); // Task 9
+        log.info("USB reconnected", .{});
+        return;
+    }
+}
+
+/// Answer everything still waiting on the connection that just died.
+/// handshake_init calls session_reset, which throws away the core's seq table,
+/// so those responses can never arrive and a client would block forever.
+fn failPending() void {
+    var n: u32 = 0;
+    for (&pending) |*slot| {
+        if (slot.*) |entry| {
+            slot.* = null;
+            n += 1;
+            sendError(entry.client_fd, entry.is_ws, .failed);
+        }
+    }
+    if (n > 0) log.warn("failed {d} in-flight requests on USB loss", .{n});
+}
+
+/// Sleep in slices so a SIGTERM during the reconnect backoff is not held for up
+/// to the full 2s.
+fn sleepUntilQuit(ms: u64) void {
+    var left = ms;
+    while (left > 0 and !quit) {
+        const chunk: u64 = @min(left, 50);
+        std.Thread.sleep(chunk * std.time.ns_per_ms);
+        left -= chunk;
+    }
+}
