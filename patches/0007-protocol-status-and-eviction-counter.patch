+/// Encode a device status message.
+/// [u8 0x04][u32 LE 3][u8 device_present][u8 calibration_applied][u8 protocol_version]
+///
+/// Distinguishes unplugged hardware from a healthy daemon whose last gaze
+/// sample is merely old, which a gaze stream alone cannot express: both look
+/// like silence.
+pub fn encodeStatus(buf: *[HEADER_SIZE + STATUS_SIZE]u8, present: bool, cal: bool) void {
+    encodeHeader(buf[0..HEADER_SIZE], @intFromEnum(Srv.status), STATUS_SIZE);
+    buf[HEADER_SIZE] = @intFromBool(present);
+    buf[HEADER_SIZE + 1] = @intFromBool(cal);
+    buf[HEADER_SIZE + 2] = PROTOCOL_VERSION;
+}
