[Unit]
Description=Tobii ET5 gaze daemon
After=graphical-session.target
PartOf=graphical-session.target
# The RestartSec backoff below already outruns the default 5-starts-in-10s
# limiter, so this is here for the operator: measured, the fifth `systemctl
# --user restart` inside 10 s latches a default unit into start-limit-hit and
# only `reset-failed` clears it. Rebuild-and-restart cycles hit that.
StartLimitIntervalSec=0

[Service]
# exec, not simple: start fails if the binary is missing or not executable.
# Not notify, which would need an sd_notify call the daemon does not have, and
# nothing downstream consumes readiness yet. The socket appears 59 to 71 ms
# after `systemctl start` returns, so a script that connects immediately after
# starting the unit must retry.
Type=exec
ExecStart=@TOBIIFREED_BIN@

# always, not on-failure, and this compensates for a known asymmetry in the
# daemon rather than expressing a preference. A daemon that loses the device
# mid-flight reconnects in process and never exits, so Restart= cannot fire and
# cannot cut a healthy session short. A daemon that cannot open the device at
# boot exits 0 (main.zig:721), so on-failure would never fire either and the
# unit would sit inactive with the tracker unclaimed.
#
# What that costs, versus the daemon retrying its own boot: recovery takes up to
# 30 s instead of the 2 s cap reconnect() uses for the first minute, and every
# connected client is dropped once per cycle rather than riding it out. Measured
# delays between attempts: 2.25, 3.5, 6.0, 10.25, 17.5, then 30 s.
#
# The real fix is not a boot retry. Server.init binds at main.zig:756, after the
# USB open, so a daemon that merely retried its boot still would not accept
# clients during an absence. That needs the socket bound before the device is
# opened, and the reorder is deliberately scoped to Phase 2, when the OBS
# plugin's requirements define what readiness has to mean.
Restart=always
RestartSec=2
RestartSteps=5
RestartMaxDelaySec=30

# Shutdown is a signal handler, a thread join and an unlink, measured at 5 to
# 54 ms. Ten seconds is generous for that and keeps a wedged libusb call from
# holding session logout for the 90 s default.
TimeoutStopSec=10

# The USB thread's duty cycle is under 1%, so this buys tail latency against
# osu! without needing CAP_SYS_NICE: /etc/security/limits.conf grants jason
# nice -10. No CPU affinity, since osu!'s is unknown.
Nice=-5

# The daemon needs no privileges. Filesystem sandboxing is deliberately absent:
# it needs /dev/bus/usb, and the binary's PT_INTERP and libusb both live in
# /nix/store, so ProtectSystem or PrivateDevices would break exec outright.
NoNewPrivileges=yes

[Install]
WantedBy=graphical-session.target
